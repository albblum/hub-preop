# Ambiente Node (opcional). Em deploy real com HTTPS, use production para HSTS nos headers.
# NODE_ENV="development"

# PostgreSQL (see docker-compose.yml in this folder)
DATABASE_URL="postgresql://hub:hub@localhost:5432/hub_preop"

# Auth.js / NextAuth — generate with: openssl rand -base64 32
# Rotating AUTH_SECRET invalidates existing sessions (users must sign in again).
AUTH_SECRET="replace-with-long-random-string"

# Optional: public URL for OAuth callbacks in non-local deploys
# AUTH_URL="http://localhost:3000"

# Optional OAuth (GitHub). Leave unset for Credentials-only sign-in.
# If set, GitHub appears as a provider; use strong secrets and never commit real values.
# AUTH_GITHUB_ID=""
# AUTH_GITHUB_SECRET=""

# ADR 0009 — enable POST /api/instruments/[id]/transition-to-multipart and npm run transition:monolith-to-multipart (admin/registrar only). Omit or 0 = disabled.
# TRANSITION_MONOLITH_TO_MULTIPART_ENABLED="1"

# Seed script passwords (founding dev users — change in real environments)
SEED_ADMIN_PASSWORD="ChangeMeAdmin!"
SEED_REVIEWER_PASSWORD="ChangeMeReviewer!"
SEED_VIEWER_PASSWORD="ChangeMeViewer!"
