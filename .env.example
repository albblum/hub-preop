# PostgreSQL (see docker-compose.yml in this folder)
DATABASE_URL="postgresql://hub:hub@localhost:5432/hub_preop"

# Auth.js / NextAuth — generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-long-random-string"

# Optional: public URL for OAuth callbacks in non-local deploys
# AUTH_URL="http://localhost:3000"

# Optional OAuth (GitHub); leave unset to keep Credentials-only
# AUTH_GITHUB_ID=""
# AUTH_GITHUB_SECRET=""

# Seed script passwords (founding dev users — change in real environments)
SEED_ADMIN_PASSWORD="ChangeMeAdmin!"
SEED_REVIEWER_PASSWORD="ChangeMeReviewer!"
SEED_VIEWER_PASSWORD="ChangeMeViewer!"
