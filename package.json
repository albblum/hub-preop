    "backfill:ledger": "tsx scripts/backfill-ledger.ts",
    "backfill:parts": "tsx scripts/backfill-part-composition.ts",
    "backfill:part-status": "tsx scripts/backfill-part-status.ts",
    "validate:markdown": "tsx scripts/validate-markdown.ts",
    "submit:content": "tsx scripts/submit-content.ts",
