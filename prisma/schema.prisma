generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Single-row counter for institutional idr:ref allocation (Phase 3 Core Registry).
/// v2: não usado para novos instrumentos com structuralProfile = v2.
model IdrSequence {
  key  String @id @default("instrument")
  next Int    @default(0)
}

/// Logical instrument head: stable idr:ref, layer, lifecycle status, derivation link.
model Instrument {
  id                     String         @id @default(cuid())
  idrRef                 String         @unique
  title                  String
  documentType           DocumentType   @default(generic)
  layer                  Int
  status                 String
  draftingAuthority      String?
  currentVersion         Int
  parentInstrumentId     String?
  parent                 Instrument?    @relation("Derivation", fields: [parentInstrumentId], references: [id])
  children               Instrument[]   @relation("Derivation")
  currentVersionRecordId String?        @unique
  currentVersionRecord   InstrumentVersion? @relation("CurrentVersionPointer", fields: [currentVersionRecordId], references: [id])
  versions               InstrumentVersion[] @relation("VersionHistory")
  events                 TransitionEvent[]
  ledgerEntries          LedgerEntry[]
  parts                  Part[]
  compositionEntries     CompositionEntry[]
  committeeMembershipsAsAuthority CommitteeMembership[] @relation("CommitteeMembershipAuthority")
  committeeId            String?
  committee              Committee?     @relation(fields: [committeeId], references: [id], onDelete: SetNull)
  consultationClosesAt   DateTime?
  consultationOpeningNote String?       @db.Text
  externalReferenceLinks InstrumentExternalReference[]

  // --- v2 extensions (ADR 0015) ---
  /// v1 = monólito/Part; v2 = árvore normativa relacional.
  structuralProfile      StructuralProfile @default(v1)
  /// Anexo citável: filho derivado; exige parentInstrumentId quando true.
  isAnnex                Boolean           @default(false)
  /// Código semântico do documento no path (foundation, preop-regime, …).
  semanticDocumentCode   String?
  /// Data de referência histórica (ex. 2026-12-31); não é gatilho automático.
  terminationDate        DateTime?         @db.Date
  terminationRequiresExplicitAct Boolean   @default(false)
  terminationAuthorizedBy  TerminationAuthorizedBy?
  /// Ex.: committees_constituted, committee_members_active, formal_act_by_secretary_general
  terminationConditions    String[]        @default([])

  normativeSections      NormativeSection[]
  instrumentRevisions    InstrumentRevision[]

  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  @@index([layer])
  @@index([status])
  @@index([committeeId])
  @@index([structuralProfile])
}

model Committee {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships CommitteeMembership[]
  instruments Instrument[]
}

model ExternalReference {
  id         String   @id @default(cuid())
  kind       ExternalReferenceKind
  title      String
  origin     String
  stableId   String
  accessedAt DateTime
  status     ExternalReferenceLifecycleStatus?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  instruments InstrumentExternalReference[]

  @@index([kind])
  @@index([stableId])
}

enum ExternalReferenceKind {
  normative
  technical
  legal
  economic
}

enum ExternalReferenceLifecycleStatus {
  active
  outdated
  revoked
}

model InstrumentExternalReference {
  instrumentId        String
  instrument          Instrument @relation(fields: [instrumentId], references: [id], onDelete: Cascade)
  externalReferenceId String
  externalReference   ExternalReference @relation(fields: [externalReferenceId], references: [id], onDelete: Cascade)
  linkedAt            DateTime @default(now())

  @@id([instrumentId, externalReferenceId])
  @@index([externalReferenceId])
}

enum CommitteeMembershipStatus {
  active
  suspended
  revoked
}

model CommitteeMembership {
  id                    String   @id @default(cuid())
  userId                String
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  committeeId           String
  committee             Committee @relation(fields: [committeeId], references: [id], onDelete: Cascade)
  startedAt             DateTime @default(now())
  endedAt               DateTime?
  status                CommitteeMembershipStatus @default(active)
  authorityInstrumentId String?
  authorityInstrument   Instrument? @relation("CommitteeMembershipAuthority", fields: [authorityInstrumentId], references: [id], onDelete: SetNull)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@index([userId, status])
  @@index([committeeId, status])
}

/// Versioned content snapshot. v1: fonte primária; v2: agregado derivado (contentSourceKind).
model InstrumentVersion {
  id                  String   @id @default(cuid())
  instrumentId        String
  instrument          Instrument @relation("VersionHistory", fields: [instrumentId], references: [id], onDelete: Cascade)
  version             Int
  content             String   @db.Text
  contentHash         String
  previousContentHash String?
  supersedesVersion   Int?
  revisionNote        String?
  /// legacy_primary (v1 editorial) | derived (v2 aggregation job).
  contentSourceKind   InstrumentVersionContentSource @default(legacy_primary)
  createdAt           DateTime @default(now())
  currentHeadFor      Instrument? @relation("CurrentVersionPointer")
  ledgerEntry         LedgerEntry?
  partVersions        PartVersion[]

  @@unique([instrumentId, version])
  @@index([instrumentId])
}

model Part {
  id           String   @id @default(cuid())
  instrumentId String
  instrument   Instrument @relation(fields: [instrumentId], references: [id], onDelete: Cascade)
  partKind     String   @default("MONOLITH_BODY")
  partStatus   String   @default("DRAFT")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  versions           PartVersion[]
  compositionEntries CompositionEntry[]

  @@unique([instrumentId, partKind])
  @@index([instrumentId])
}

model PartVersion {
  id                  String   @id @default(cuid())
  partId              String
  part                Part     @relation(fields: [partId], references: [id], onDelete: Cascade)
  instrumentVersionId String
  instrumentVersion   InstrumentVersion @relation(fields: [instrumentVersionId], references: [id], onDelete: Cascade)
  contentHash         String
  ordinal             Int      @default(1)
  markdownBody        String?  @db.Text
  createdAt           DateTime @default(now())

  @@unique([instrumentVersionId, partId])
  @@index([partId])
}

model CompositionEntry {
  id           String   @id @default(cuid())
  instrumentId String
  instrument   Instrument @relation(fields: [instrumentId], references: [id], onDelete: Cascade)
  partId       String
  part         Part     @relation(fields: [partId], references: [id], onDelete: Cascade)
  position     Int

  @@unique([instrumentId, position])
  @@unique([instrumentId, partId])
  @@index([instrumentId])
}

model TransitionEvent {
  id              String     @id @default(cuid())
  instrumentId    String
  instrument      Instrument @relation(fields: [instrumentId], references: [id], onDelete: Cascade)
  fromStatus      String
  toStatus        String
  at              DateTime   @default(now())
  actor           String?
  actorKind       ActorKind  @default(system)
  actorLabel      String?
  actorExternalId String?
  note            String?
  ledgerEntry     LedgerEntry?

  @@index([instrumentId, at])
}

model LedgerEntry {
  id                  String   @id @default(cuid())
  instrumentId        String
  instrument          Instrument @relation(fields: [instrumentId], references: [id], onDelete: Cascade)
  sequence            Int
  previousEntryId     String?
  previousEntry       LedgerEntry?  @relation("LedgerChain", fields: [previousEntryId], references: [id], onDelete: SetNull)
  nextInChain         LedgerEntry[] @relation("LedgerChain")
  entryType           String
  payloadHash         String
  idrRef              String
  instrumentVersionId String?  @unique
  instrumentVersion   InstrumentVersion? @relation(fields: [instrumentVersionId], references: [id], onDelete: SetNull)
  transitionEventId   String?  @unique
  transitionEvent     TransitionEvent? @relation(fields: [transitionEventId], references: [id], onDelete: SetNull)
  createdAt           DateTime @default(now())

  @@unique([instrumentId, sequence])
  @@index([instrumentId, sequence])
  @@index([instrumentId, createdAt])
}

/// Phase 4: registered audit export with manifest self-hash.
model ExportManifest {
  id                  String   @id @default(cuid())
  createdAt           DateTime @default(now())
  scopeDescription    String
  requestedBy         String?
  /// SHA-256 (hex) of stable JSON manifest body (see Fase4 spec).
  contentHash         String
  exportSchemaVersion String   @default("1")
}

enum ActorKind {
  human
  system
  api_key
}

enum HubRole {
  admin
  registrar
  reviewer
  viewer_public
  viewer_registered
  /// Autoridade institucional de facto (pré-operacional); não é admin técnico.
  secretary_general
  /// Membro provisório durante o regime pré-operacional.
  provisional_member
}

enum DocumentType {
  constitutional
  operational
  institutional
  generic
}

// --- v2 enums (ADR 0015) ---

enum StructuralProfile {
  v1
  v2
}

enum NormativeMigrationPhase {
  pilot
  deferred
  complete
}

enum IdrRefOwnerKind {
  instrument
  section
  article
  paragraph
  clause
}

enum InstrumentVersionContentSource {
  legacy_primary
  derived
}

enum TerminationAuthorizedBy {
  secretary_general
}

// --- v2 normative tree (ADR 0015) ---

/// Secção editorial (Preamble, Article I, Change Log, …).
model NormativeSection {
  id                    String   @id @default(cuid())
  instrumentId          String
  instrument            Instrument @relation(fields: [instrumentId], references: [id], onDelete: Cascade)
  position              Int
  code                  String
  title                 String?
  nonNormative          Boolean  @default(false)
  migrationPhase        NormativeMigrationPhase?
  publishedAt           DateTime?
  supersededBySectionId String?
  supersededBy          NormativeSection?  @relation("SectionSupersession", fields: [supersededBySectionId], references: [id], onDelete: SetNull)
  supersedes            NormativeSection[] @relation("SectionSupersession")
  articles              NormativeArticle[]
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@unique([instrumentId, position])
  @@unique([instrumentId, code])
  @@index([instrumentId])
}

model NormativeArticle {
  id          String   @id @default(cuid())
  sectionId   String
  section     NormativeSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  position    Int
  articleCode String
  title       String?
  paragraphs  NormativeParagraph[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([sectionId, position])
  @@unique([sectionId, articleCode])
  @@index([sectionId])
}

model NormativeParagraph {
  id            String   @id @default(cuid())
  articleId     String
  article       NormativeArticle @relation(fields: [articleId], references: [id], onDelete: Cascade)
  position      Int
  paragraphCode String
  clauses       NormativeClause[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([articleId, position])
  @@unique([articleId, paragraphCode])
  @@index([articleId])
}

/// Unidade mínima endereçável; idrRef completo e único no sistema.
model NormativeClause {
  id                   String   @id @default(cuid())
  paragraphId          String
  paragraph            NormativeParagraph @relation(fields: [paragraphId], references: [id], onDelete: Cascade)
  position             Int
  clauseCode           String
  idrRef               String   @unique
  publishedAt          DateTime?
  supersededByClauseId String?
  supersededBy         NormativeClause?  @relation("ClauseSupersession", fields: [supersededByClauseId], references: [id], onDelete: SetNull)
  supersedes           NormativeClause[] @relation("ClauseSupersession")
  currentVersionId     String?  @unique
  currentVersion       ClauseVersion? @relation("CurrentClauseVersion", fields: [currentVersionId], references: [id], onDelete: SetNull)
  versions             ClauseVersion[] @relation("ClauseVersionHistory")
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@unique([paragraphId, position])
  @@unique([paragraphId, clauseCode])
  @@index([paragraphId])
}

/// Texto canónico por revisão; imutável após publicação/ledger.
model ClauseVersion {
  id                  String   @id @default(cuid())
  clauseId            String
  clause              NormativeClause @relation("ClauseVersionHistory", fields: [clauseId], references: [id], onDelete: Cascade)
  version             Int
  body                String   @db.Text
  contentHash         String
  previousContentHash String?
  revisionNote        String?
  isCurrent           Boolean  @default(false)
  createdAt           DateTime @default(now())
  createdBy           String?
  currentHeadFor      NormativeClause? @relation("CurrentClauseVersion")
  revisionMemberships InstrumentRevisionClauseVersion[]

  @@unique([clauseId, version])
  @@index([clauseId])
  @@index([clauseId, isCurrent])
}

/// Unicidade global de idrRef semântico activo.
model IdrRefRegistry {
  idrRef          String          @id
  ownerKind       IdrRefOwnerKind
  ownerId         String
  grammarVersion  String          @default("1")
  registeredAt    DateTime        @default(now())

  @@index([ownerKind, ownerId])
}

/// Ponte idr:HUB-INSTR-* → idrRef semântico durante transição.
model IdrRefAlias {
  legacyRef     String  @id
  canonicalRef  String
  ownerKind     IdrRefOwnerKind?
  ownerId       String?
  note          String?
  createdAt     DateTime @default(now())

  @@index([canonicalRef])
}

/// Índice de revisão do documento (agregado derivado; texto canónico nas cláusulas).
model InstrumentRevision {
  id                   String   @id @default(cuid())
  instrumentId         String
  instrument           Instrument @relation(fields: [instrumentId], references: [id], onDelete: Cascade)
  revisionNumber       Int
  aggregateContentHash String
  createdAt            DateTime @default(now())
  clauseVersions       InstrumentRevisionClauseVersion[]

  @@unique([instrumentId, revisionNumber])
  @@index([instrumentId])
}

model InstrumentRevisionClauseVersion {
  instrumentRevisionId String
  instrumentRevision   InstrumentRevision @relation(fields: [instrumentRevisionId], references: [id], onDelete: Cascade)
  clauseVersionId      String
  clauseVersion        ClauseVersion @relation(fields: [clauseVersionId], references: [id], onDelete: Restrict)

  @@id([instrumentRevisionId, clauseVersionId])
  @@index([clauseVersionId])
}

model User {
  id                   String    @id @default(cuid())
  email                String    @unique
  passwordHash         String?
  name                 String?
  roles                HubRole[]
  committeeMemberships CommitteeMembership[]
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
}
