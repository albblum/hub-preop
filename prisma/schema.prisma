generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Minimal persistence stub for Hub pre-op Phase 2 (not the full Core Registry).
model InstrumentStub {
  id        String   @id @default(cuid())
  title     String
  layer     Int
  status    String
  content   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
